{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fokhruli.github.io/JEPA-all/schema.json",
  "title": "JEPA Atlas knowledge base",
  "type": "object",
  "required": ["schema_version", "title", "review_date", "scope", "evidence_policy", "papers", "concepts", "paths", "relations"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "review_date": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "evidence_policy": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "papers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^\\d{4}\\.\\d{4,5}$"},
          "name": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "group": {"type": "string", "minLength": 1},
          "problem": {"type": "string", "minLength": 1},
          "intuition": {"type": "string", "minLength": 1},
          "mechanism": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "training": {"type": "string", "minLength": 1},
          "deployment": {"type": "string", "minLength": 1},
          "experiment": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "concepts": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "audit": {"type": "string"},
          "review": {"enum": ["sections_checked", "abstract_only"]},
          "source": {
            "type": "object", "additionalProperties": false,
            "required": ["url", "version", "checked", "locators"],
            "properties": {
              "url": {"type": "string", "pattern": "^https://arxiv\\.org/(html|abs)/\\d{4}\\.\\d{4,5}v\\d+$"},
              "version": {"type": "string", "pattern": "^v\\d+$"},
              "checked": {"type": "string", "format": "date"},
              "locators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          },
          "results": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "task": {"type": "string", "minLength": 1},
                "metric": {"type": "string", "minLength": 1},
                "unit": {"type": "string", "minLength": 1},
                "protocol": {"type": "string", "minLength": 1},
                "locator": {"type": "string", "minLength": 1},
                "value": {"type": ["number", "string", "array", "null"], "items": {"type": "number"}},
                "baseline": {"type": ["string", "null"]},
                "baseline_value": {"type": ["number", "string", "array", "null"], "items": {"type": "number"}},
                "uncertainty": {"type": ["string", "null"]},
                "direction": {"enum": ["higher", "lower", "descriptive"]},
                "note": {"type": "string"}
              },
              "required": ["task", "metric", "unit", "protocol", "locator", "value", "baseline", "baseline_value", "uncertainty", "direction", "note"]
            }
          }
        },
        "required": ["id", "name", "title", "group", "problem", "intuition", "mechanism", "objective", "training", "deployment", "experiment", "aliases", "concepts", "limitations", "audit", "review", "source", "results"]
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "plain": {"type": "string", "minLength": 1},
          "technical": {"type": "string", "minLength": 1},
          "caution": {"type": "string", "minLength": 1},
          "papers": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "required": ["id", "name", "question", "plain", "technical", "caution", "papers"]
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "description", "steps"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "steps": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "string", "minLength": 1}, {"type": "string", "minLength": 1}], "items": false, "minItems": 2, "maxItems": 2}}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "target", "kind", "why", "source_url", "locator"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "kind": {"enum": ["documented_comparison", "curator_comparison", "curator_tension"]},
          "why": {"type": "string", "minLength": 1},
          "source_url": {"type": ["string", "null"]},
          "locator": {"type": ["string", "null"]}
        }
      }
    }
  }
}
